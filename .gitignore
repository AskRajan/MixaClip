# Python Virtual Environments & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
build/
dist/
.pytest_cache/

# Binaries & Tool Executables (GitHub 100MB file limit)
*.exe
bin/

# AI Models (Whisper weights exceed 100MB)
*.bin
storage/cache/models/

# Media Files & Storage (Local work only - Never commit large media to Git)
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.flv
*.mp3
*.wav
*.m4a
*.aac
storage/downloads/*
storage/cache/*
storage/output/*
!storage/downloads/.gitkeep
!storage/cache/.gitkeep
!storage/output/.gitkeep
.temp_ass/

# OS & Editor Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment Secrets
.env
.env.local
